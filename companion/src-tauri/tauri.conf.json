{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Subagent Monitor",
  "version": "0.2.0",
  "identifier": "com.opencode.subagent.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCode Subagent Monitor",
        "width": 400,
        "height": 300,
        "minWidth": 320,
        "minHeight": 200,
        "resizable": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}