{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "declaration": false,
    "noEmit": false,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../state.ts"],
  "exclude": ["node_modules", "dist"]
}